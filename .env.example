# fritZ Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!
#
# This file is for SECRETS and INFRASTRUCTURE IDENTITY only.
# For operational tuning (timeouts, intervals, feature toggles),
# see fritz-orchestrator/config/fritz.yaml

# Optional: Anthropic Claude API key (not needed if Claude Code CLI is authenticated)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Required: Telegram bot token
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Required: Your Telegram chat ID
# Get from: @userinfobot on Telegram
TELEGRAM_CHAT_ID=123456789

# Optional: GitHub personal access token
# Get from: https://github.com/settings/tokens
# Needed for: GitHub issue/PR automation
GH_TOKEN=ghp_xxxxx

# Optional: GitHub repository
# Format: owner/repo
# Example: your-org/fritZ
GITHUB_REPO=username/repo
