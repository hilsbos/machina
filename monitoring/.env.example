# Monitoring stack environment variables
# Copy to .env and fill in values

# Grafana admin password (change this!)
GRAFANA_ADMIN_PASSWORD=changeme

# Telegram alerting (used by alertmanager)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GID of docker group on host — run: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
