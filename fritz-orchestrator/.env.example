# fritZ Configuration
# Copy to .env and fill in your values
#
# This file is for SECRETS and INFRASTRUCTURE IDENTITY only.
# For operational tuning (timeouts, intervals, feature toggles, agent behavior),
# see config/fritz.yaml

# === CLAUDE CODE AUTHENTICATION ===
# Option 1 (recommended for production): OAuth token
# Set CLAUDE_CODE_OAUTH_TOKEN to skip all credential file mounting/copying.
# The token is passed directly to agent containers via environment variable.
# CLAUDE_CODE_OAUTH_TOKEN=
# Optional: Display name for the account (shown in dashboard and Telegram status)
# CLAUDE_ACCOUNT_NAME=Owner

# Option 2 (fallback): API key billing
# Only needed if Claude Code CLI is not authenticated (e.g., CI/CD environments)
# Get from: https://console.anthropic.com/
# Pay-per-token billing (more expensive than subscription)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Option 3 (legacy): File-based credentials
# Mount ~/.claude directory with .credentials.json / subscription_token.json
# This is the default when neither token nor API key is set

# === TELEGRAM (REQUIRED) ===
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Chat ID: visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890
# Telegram handle to tag when agent input is needed (e.g., blocked or asking a question)
# TELEGRAM_TAG_HANDLE=@your-org

# === GITHUB (optional but recommended) ===
# Create at: https://github.com/settings/tokens (scopes: repo, read:org)
GH_TOKEN=ghp_xxxxx
GITHUB_REPO=username/repo

# === DOCKER ===
# Docker image name for agents (agents always run in Docker containers)
DOCKER_IMAGE=fritz-agent
# Container registry for auto-pulling agent images (default: ghcr.io/your-org)
# GHCR_REGISTRY=ghcr.io/your-org

# Production (Docker-in-Docker path mapping):
# When the daemon runs inside Docker, it needs host paths to mount into agent containers.
# These are required for production Docker Compose deployments.
# HOST_WORKSPACES_DIR=/opt/fritz/.workspaces
# HOST_CLAUDE_HOME=/home/fritz/.claude

# === DASHBOARD mTLS (optional) ===
# Domain for the mTLS dashboard proxy (used in nginx server_name and cert SAN)
# FRITZ_DOMAIN=your-server.example.com
# Port for the mTLS dashboard proxy on the host (default: disabled, set to e.g. 8443 to enable)
# FRITZ_DASHBOARD_PORT=8443
# Password for the auto-generated client .p12 certificate bundle
# FRITZ_CLIENT_CERT_PASS=changeme

# === FRITZBRIDGE (optional, bridge to an external agent system) ===
# WebSocket URL of the external agent gateway
# EXTERNAL_AGENT_GATEWAY_URL=ws://external-agent-gateway:18789
# Auth token for the external agent gateway
# EXTERNAL_AGENT_GATEWAY_TOKEN=
# Shared secret for authenticating requests to the bridge API
# BRIDGE_API_TOKEN=
# External agent to forward fritZ events to (default: main)
# FRITZ_FORWARD_AGENT=main
# Notification level: critical (default), normal, or verbose
# FRITZ_NOTIFICATION_LEVEL=critical

# === NETWORK (optional, auto-detected) ===
# FRITZ_API_PORT=3456
# FRITZ_DAEMON_URL=http://host.docker.internal:3456

# === RUNTIME MODE (optional override) ===
# Force runtime mode (auto-detected by default)
# FRITZ_RUNTIME_MODE=docker  # Force Docker mode
# FRITZ_RUNTIME_MODE=native  # Force native mode
